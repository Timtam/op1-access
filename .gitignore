# Build artifacts
build/
out/
.xmake/
*.obj
*.pdb
*.lib
*.exp
*.ilk

# IDE
.vs/
.vscode/
*.user
*.sln.docstates
CMakeSettings.json

# UE4SS-generated dumps (large, regenerate locally)
dump/
UE4SS_*.log
ue4ss.log

# Tools — downloaded fresh by setup, not committed
tools/

# Game pak unpacks (gitignored — never redistribute)
unpacked/
*.pak
*.utoc
*.ucas

# OS
Thumbs.db
desktop.ini
.DS_Store

# user's local cue staging folder (canonical copies live in scripts/Mods/OP1Access/Assets/)
/Assets/

# Python caches (scripts/i18n.py, level-links.py)
__pycache__/

# the mod's remembered game language (written next to the .po files at run time)
scripts/Mods/OP1Access/Scripts/lang/last.txt

# Release builds
dist/
installer/**/bin/
installer/**/obj/
